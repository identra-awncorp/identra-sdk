{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@identra/sdk-core": ["./packages/core/src/index.ts"],
      "@identra/sdk-client": ["./packages/client/src/index.ts"],
      "@identra/sdk-app": ["./packages/app/src/index.ts"],
      "@identra/sdk-server": ["./packages/server/src/index.ts"]
    }
  }
}
